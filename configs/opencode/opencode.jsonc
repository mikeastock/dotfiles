{
  "$schema": "https://opencode.ai/config.json",
  "model": "runinfra/deepseek-v4-flash",
  "small_model": "runinfra/nemotron-3-5-lightning-30b",
  "provider": {
    "runinfra": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "RunInfra",
      "env": ["RUNINFRA_GATEWAY_KEY"],
      "whitelist": [
        "deepseek-v4-flash",
        "deepseek-v4-pro",
        "glm-5-3-flash",
        "nemotron-3-5-lightning-30b",
        "ornith-1-5-35b",
        "qwen3-8-27b",
        "qwen3-8-2-4t-a95b"
      ],
      "options": {
        "baseURL": "https://api.runinfra.ai/v1",
        "apiKey": "{env:RUNINFRA_GATEWAY_KEY}",
        "setCacheKey": true,
        "timeout": 240000
      },
      "models": {
        "deepseek-v4-flash": {
          "name": "DeepSeek V4 Flash",
          "reasoning": true,
          "temperature": true,
          "tool_call": true,
          "attachment": false,
          "interleaved": {
            "field": "reasoning"
          },
          "limit": {
            "context": 1048576,
            "output": 65536
          },
          "cost": {
            "input": 0.13,
            "output": 0.27,
            "cache_read": 0.01
          },
          "modalities": {
            "input": ["text"],
            "output": ["text"]
          }
        },
        "deepseek-v4-pro": {
          "name": "DeepSeek V4 Pro",
          "reasoning": true,
          "temperature": true,
          "tool_call": true,
          "attachment": false,
          "interleaved": {
            "field": "reasoning"
          },
          "limit": {
            "context": 1048576,
            "output": 65536
          },
          "cost": {
            "input": 0.6,
            "output": 1.9,
            "cache_read": 0.03
          },
          "modalities": {
            "input": ["text"],
            "output": ["text"]
          }
        },
        "glm-5-3-flash": {
