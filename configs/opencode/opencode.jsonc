            "output": 65536
          },
          "cost": {
            "input": 0.05,
            "output": 0.15,
            "cache_read": 0.01
          },
          "modalities": {
            "input": ["text"],
            "output": ["text"]
          }
        },
        "ornith-1-5-35b": {
