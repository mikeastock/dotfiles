{
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "scopey hook user-prompt",
            "timeout": 15,
            "statusMessage": "scopey UserPromptSubmit"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "scopey hook session-start",
            "timeout": 15,
            "statusMessage": "scopey SessionStart"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "scopey hook post-tool",
            "timeout": 15,
            "statusMessage": "scopey PostToolUse"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "scopey hook stop",
            "timeout": 15,
            "statusMessage": "scopey Stop"
          }
        ]
      }
    ]
  }
}
