{
  "name": "bb-plugin-bb-sidebar",
  "version": "0.2.4",
  "type": "module",
  "description": "A bb thread sidebar with manual and automatic sorting, snooze, settle, bulk actions, and a Bots shelf for the Bots Sidebar plugin.",
  "license": "MIT",
  "author": "Yusuf Akbulut",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yusuf8834/bb-sidebar.git"
  },
  "homepage": "https://github.com/yusuf8834/bb-sidebar#readme",
  "bugs": {
    "url": "https://github.com/yusuf8834/bb-sidebar/issues"
  },
  "engines": {
    "bb": ">=0.42.0",
    "bbPluginSdk": ">=0.4.47"
  },
  "bb": {
    "name": "BB Sidebar",
    "description": "Organizes bb threads with manual and automatic sorting, snooze, settle, and bulk actions; shows bots from the Bots Sidebar plugin as their own shelf.",
    "branding": {
      "icon": "PanelLeft"
    },
    "app": "./app.tsx",
    "server": "./src/server.ts"
  },
  "keywords": [
    "bb-plugin",
    "sidebar",
    "threads",
    "inbox",
    "productivity"
  ],
  "scripts": {
    "build": "bb plugin build",
    "check": "npm run typecheck && npm test && npm run build",
    "test": "vitest run --config vitest.config.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@formkit/auto-animate": "^0.9.0",
    "@hugeicons/core-free-icons": "^4.1.3",
    "@hugeicons/react": "^1.1.6",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@get-bb/plugin-sdk": "0.4.47",
    "@pierre/diffs": "^1.2.9",
    "@radix-ui/react-alert-dialog": "^1.1.19",
    "@radix-ui/react-context-menu": "^2.3.3",
    "@radix-ui/react-dialog": "^1.1.19",
    "@radix-ui/react-dropdown-menu": "^2.1.20",
    "@radix-ui/react-hover-card": "^1.1.19",
    "@radix-ui/react-menubar": "^1.1.20",
    "@radix-ui/react-navigation-menu": "^1.2.18",
    "@radix-ui/react-popover": "^1.1.19",
    "@radix-ui/react-select": "^2.3.3",
    "@radix-ui/react-tooltip": "^1.2.12",
    "@testing-library/react": "^16.3.2",
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "bb-app": "0.42.1",
    "better-sqlite3": "12.10.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cron-parser": "^5.10.0",
    "hono": "^4.13.3",
    "jsdom": "^29.0.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "sonner": "^1.7.4",
    "tailwind-merge": "^3.4.0",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "vaul": "^1.1.2",
    "vitest": "^4.1.1"
  }
